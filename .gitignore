# Build artifacts
*.exe
*.dll
*.pdb
*.o
*.lib
*.exp

# the shipped standalone app IS the exe — keep it tracked
!dist/ayesha-os.exe
# ...and the linux/termux elf is the same app — keep it tracked too
!dist/ayesha-os

# Prevent applet build artifacts from polluting dist
dist/applets/*/node_modules/
dist/applets/*/src/
dist/applets/*/dist/
dist/applets/*/package*.json
dist/applets/*/tsconfig.json
dist/applets/*/*.ts
dist/applets/*/*.tsx

# HF repo clones (gitignored — pushed separately by sync-all.ps1)
_hf-model/
_hf-space/

# Tri-mind sync state (local state only)
.tri_mind_state/github_repo/
.tri_mind_state/local_manifests.json
.tri_mind_state/engine_state.json

# Logs
*.log
logs/

# Automation harness local state (queue, reports, backups, logs)
.automation/

# Engine output capture (selftest / banner dumps)
test-output.txt

# Stale engine source backup
*.backup

# Web prototype build artifact (source lives in the HF bot space)
ayesha-bot.zip

# Local archive of removed/dead files (kept for easy restore)
_archive/

# Deepwork session state (local progress files)
.slim/deepwork/
