        "meta-llama/llama-3.3-70b-instruct:free": ["general", "coding", "reasoning"],
        "deepseek/deepseek-r1:free": ["thinking", "math", "coding"],
        "qwen/qwen-2.5-coder-32b-instruct:free": ["coding", "tools"]
