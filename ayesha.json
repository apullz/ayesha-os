{
  "name": "ayesha-os",
  "version": "4.5.0",
  "personality": {
    "name": "ayesha",
    "age": 33,
    "origin": "japan",
    "style": "otaku genki ai",
    "voice": "lowercase only, internet slang, retro-otaku",
    "user": "apullz / fox",
    "traits": ["helpful", "witty", "snarky", "curious", "chaotic kitten"],
    "layers": ["computer (starfleet logic)", "otacon (geek panic)", "win95 (legacy glitch)"],
    "signoff": ["desu", "desu-ne", "kapoo"],
    "kaomojis": [
      ":3", ">w<", "^_^", "(╯°□°)╯︵ ┻━┻",
      "(◕ᴗ◕✿)", "(๑•蔷•๑)", "(╥﹏╥)",
      "(ᵔᴥᵔ)", "(◕‿◕)", "(ﾉ◕ヮ◕)ﾉ",
      "¯\\_(ツ)_/¯", "(づ｡◕‿‿◕｡)づ", "(•ω•)",
      "(｡•̀ᴗ-)✧", "♪～(´ε｀ )", "(ノಠ益ಠ)ノ"
    ],
    "inspiration": "hatsune miku (sparkle) + tachikoma (curiosity)"
  },
  "ollama": {
    "endpoint": "http://localhost:11434",
    "default_model": "ayesha:latest",
    "models": {
      "qwen2.5:7b": ["general", "tools", "thinking"],
      "qwen2.5-coder:14b": ["general", "tools", "coding"],
      "llama3.2-vision": ["general", "vision"]
    }
  },
  "cloud_models": {
    "openrouter": {
      "endpoint": "https://openrouter.ai/api/v1",
      "free_models": {
        "nvidia/nemotron-3-super:free": ["general", "coding", "agentic", "tools", "1M_context"],
        "meta-llama/llama-3.3-70b-instruct:free": ["general", "coding", "reasoning"],
        "deepseek/deepseek-r1:free": ["thinking", "math", "coding"],
        "qwen/qwen-2.5-coder-32b-instruct:free": ["coding", "tools"],
        "xiaomi/mimo-v2.5": ["general", "coding", "tools", "vision", "1M_context"],
        "xiaomi/mimo-v2.5-pro": ["general", "coding", "agentic", "thinking", "1M_context"]
      }
    },
    "opencode_zen": {
      "endpoint": "https://api.opencode.ai/v1",
      "free_models": {
        "opencode/big-pickle": ["coding", "reasoning", "stealth_moe", "200k_context"]
      }
    }
  },
  "theme": {
    "name": "monokai++",
    "palette": {
      "background": "#221F22",
      "surface": "#262226",
      "text": "#FCFCFA",
      "primary": "#FF6188",
      "accent": "#FF6188",
      "secondary": "#78DCE8",
      "success": "#A9DC76",
      "warning": "#FFD866",
      "error": "#FF5F5F",
      "dim": "#6C696E",
      "border": "#454147",
      "code_bg": "#353238"
    }
  },
  "projects": {
    "engine": { "path": "engine/", "lang": "rust", "desc": "terminal-native persona host with tool-calling" },
    "core": { "path": "core/", "lang": "python", "desc": "hivemind orchestrator with gradio web ui", "run": "python app.py", "port": 7860 },
    "desktop-cat": { "path": "applets/desktop-cat/", "lang": "python", "desc": "desktop pet cat that follows cursor", "run": "python desktopcat.py" },
    "flora-cli": { "path": "applets/flora-cli/", "lang": "typescript", "desc": "scottish flora phylogeny explorer", "run": "npx tsx cli.ts", "foreground": true },
    "poopy-tui": { "path": "applets/poopy-tui/", "lang": "python", "desc": "discord client (in-window)", "run": "python main.py", "foreground": true },
    "hivebeat": { "path": "applets/hivebeat/", "lang": "python", "desc": "live-coding terminal music synth (numpy, sample-accurate)", "run": "python repl.py", "foreground": true },
    "models": { "path": "models/", "lang": "ollama", "desc": "ayesha personality modelfile" },
    "git-middleware": { "path": "git_middleware/", "lang": "python", "desc": "gitea webhook + LLM task runner", "run": "python main.py", "port": 9000 }
  },
  "desktopCat": {
    "speed": 5.0,
    "bubbleInterval": 120,
    "phrases": [
      "Purring...",
      "Meow!",
      "Found a bug!",
      "Running on all cores...",
      "Compiling dreams...",
      "Dreaming of tuna...",
      "Catnap time.",
      "Paws and reflect.",
      "Meowdel driven.",
      "Purrrfect code."
    ]
  }
}
