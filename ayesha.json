    "models": { "path": "models/", "lang": "ollama", "desc": "ayesha personality modelfile" },
    "git-middleware": { "path": "git_middleware/", "lang": "python", "desc": "gitea webhook + LLM task runner", "run": "python main.py", "port": 9000 }
