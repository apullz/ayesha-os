  "projects": {
    "engine": { "path": "engine/", "lang": "rust", "desc": "terminal-native persona host with tool-calling" },
    "core": { "path": "core/", "lang": "python", "desc": "hivemind orchestrator with gradio web ui", "run": "python app.py", "port": 7860 },
